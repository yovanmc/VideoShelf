<UserControl x:Class="VideoShelf.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
            <conv:NotNullOrEmptyToVisibility x:Key="NotNullOrEmptyToVis" />
            <conv:NotNullToVisibility x:Key="NotNullToVis" />
            <conv:CountToVisibility x:Key="CountToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="860" HorizontalAlignment="Left">

            <!-- Page header -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Library Health" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                           Style="{StaticResource SecondaryButton}" />
            </Grid>

            <!-- Scan-diff banner (shown only when ScanSummaryText is set) -->
            <Border Margin="0,0,0,16"
                    Padding="12,8"
                    CornerRadius="{StaticResource ControlRadius}"
                    Background="{StaticResource ChipFillBrush}"
                    Visibility="{Binding ScanSummaryText, Converter={StaticResource NotNullOrEmptyToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScanSummaryText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Summary tiles ─────────────────────────────────────────── -->
            <TextBlock Text="OVERVIEW" Style="{StaticResource SectionHeader}" Margin="{StaticResource SectionGap}" />

            <UniformGrid Rows="2" Columns="3" Margin="0,8,0,16">

                <!-- Missing videos -->
                <Border Margin="0,0,8,8" Padding="16"
                        CornerRadius="{StaticResource ControlRadius}"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Missing files" Style="{StaticResource Caption}" Opacity="0.7" />
                        <TextBlock Text="{Binding MissingCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Orphan series -->
                <Border Margin="0,0,8,8" Padding="16"
                        CornerRadius="{StaticResource ControlRadius}"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Orphan series" Style="{StaticResource Caption}" Opacity="0.7" />
                        <TextBlock Text="{Binding OrphanSeriesCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Empty creators -->
                <Border Margin="0,0,0,8" Padding="16"
                        CornerRadius="{StaticResource ControlRadius}"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Empty creators" Style="{StaticResource Caption}" Opacity="0.7" />
                        <TextBlock Text="{Binding EmptyCreatorCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Single-file series -->
                <Border Margin="0,0,8,0" Padding="16"
                        CornerRadius="{StaticResource ControlRadius}"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Single-file series" Style="{StaticResource Caption}" Opacity="0.7" />
                        <TextBlock Text="{Binding SingleFileSeriesCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Duplicate groups -->
                <Border Margin="0,0,8,0" Padding="16"
                        CornerRadius="{StaticResource ControlRadius}"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Duplicate groups" Style="{StaticResource Caption}" Opacity="0.7" />
                        <TextBlock Text="{Binding DuplicateGroupCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- DB size -->
                <Border Margin="0,0,0,0" Padding="16"
                        CornerRadius="{StaticResource ControlRadius}"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Database size" Style="{StaticResource Caption}" Opacity="0.7" />
                        <TextBlock Text="{Binding DbSizeText}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ── Per-source health cards ────────────────────────────────── -->
            <TextBlock Text="SOURCES" Style="{StaticResource SectionHeader}" Margin="{StaticResource SectionGap}" />

            <ItemsControl ItemsSource="{Binding SourceRows}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16"
                                CornerRadius="{StaticResource ControlRadius}"
                                Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: source info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding RootPath}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding VideoCount, Mode=OneWay}" />
                                            <Run Text=" videos" />
                                        </TextBlock>
                                        <TextBlock Text=" · " FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Last scan: " />
                                            <Run Text="{Binding LastScanText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: rescan button + spinner -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="16,0,0,0">
                                    <ui:ProgressRing IsIndeterminate="True"
                                                     Width="18" Height="18"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsRescanning, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Content="Rescan"
                                               Command="{Binding RescanSourceCommand}"
                                               Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── M18-F: Missing-file triage ─────────────────────────────── -->
            <!-- Entire triage section hidden when Triage VM is not wired (slim test contexts). -->
            <StackPanel Visibility="{Binding Triage, Converter={StaticResource NotNullToVis}}">

                <!-- MISSING FILES header + list — only shown when list is non-empty -->
                <TextBlock Text="MISSING FILES" Style="{StaticResource SectionHeader}" Margin="{StaticResource SectionGap}"
                           Visibility="{Binding Triage.MissingVideos.Count, Converter={StaticResource CountToVis}}" />

                <!-- Status message (relink / auto-find feedback) -->
                <TextBlock Text="{Binding Triage.StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,8"
                           Visibility="{Binding Triage.StatusMessage, Converter={StaticResource NotNullOrEmptyToVis}}" />

                <!-- Missing video rows -->
                <ItemsControl ItemsSource="{Binding Triage.MissingVideos}" Margin="0,4,0,0"
                              Visibility="{Binding Triage.MissingVideos.Count, Converter={StaticResource CountToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="14,10"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding CreatorName, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding SeriesTitle, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding FilePath}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Opacity="0.6"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                        <ui:Button Content="Auto-find"
                                                   Command="{Binding AutoFindCommand}"
                                                   Style="{StaticResource SecondaryButton}"
                                                   Margin="0,0,6,0" />
                                        <ui:Button Content="Relink…"
                                                   Command="{Binding RelinkCommand}"
                                                   Style="{StaticResource SecondaryButton}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── Orphan series ─────────────────────────────────────── -->
                <!-- Header + list only shown when list is non-empty -->
                <TextBlock Text="ORPHAN SERIES" Style="{StaticResource SectionHeader}" Margin="{StaticResource SectionGap}"
                           Visibility="{Binding Triage.OrphanSeries.Count, Converter={StaticResource CountToVis}}" />

                <ItemsControl ItemsSource="{Binding Triage.OrphanSeries}" Margin="0,4,0,0"
                              Visibility="{Binding Triage.OrphanSeries.Count, Converter={StaticResource CountToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="14,10"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CreatorName}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1"
                                               Content="Remove from library"
                                               Command="{Binding RemoveFromLibraryCommand}"
                                               Style="{StaticResource SecondaryButton}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── Empty creators ────────────────────────────────────── -->
                <!-- Header + list only shown when list is non-empty -->
                <TextBlock Text="EMPTY CREATORS" Style="{StaticResource SectionHeader}" Margin="{StaticResource SectionGap}"
                           Visibility="{Binding Triage.EmptyCreators.Count, Converter={StaticResource CountToVis}}" />

                <ItemsControl ItemsSource="{Binding Triage.EmptyCreators}" Margin="0,4,0,0"
                              Visibility="{Binding Triage.EmptyCreators.Count, Converter={StaticResource CountToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="14,10"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Background="{DynamicResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding CreatorName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="1"
                                               Content="Remove from library"
                                               Command="{Binding RemoveFromLibraryCommand}"
                                               Style="{StaticResource SecondaryButton}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
