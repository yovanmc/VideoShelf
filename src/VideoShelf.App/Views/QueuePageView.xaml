<UserControl x:Class="VideoShelf.App.Views.QueuePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header row: title + count label + Clear all button -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="UP NEXT" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PlayQueue.CountLabel}" Style="{StaticResource Caption}"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:Button Content="Clear all" HorizontalAlignment="Right"
                       Command="{Binding PlayQueue.ClearCommand}"
                       Style="{StaticResource SecondaryButton}"/>
        </Grid>

        <!-- G9: Queue empty state -->
        <TextBlock Grid.Row="1"
                   Text="Queue is empty — add videos from any creator page."
                   Foreground="{StaticResource TextMutedBrush}"
                   VerticalAlignment="Top" Margin="0,16,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PlayQueue.HasQueue}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Queue item list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl DataContext="{Binding PlayQueue}"
                          ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource QueueItemTemplate}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
