<UserControl x:Class="VideoShelf.App.Views.DuplicateResolveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
            <conv:NotNullOrEmptyToVisibility x:Key="NotNullOrEmptyToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="860" HorizontalAlignment="Left">

            <!-- Page header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Compare duplicates" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Pick the file to keep. All others will be sent to the Recycle Bin."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <!-- "Not a duplicate" dismiss button -->
                <ui:Button Grid.Column="1" Command="{Binding NotADuplicateCommand}"
                           Style="{StaticResource SecondaryButton}"
                           VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                        <TextBlock Text="Not a duplicate" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Status / error banner -->
            <Border Margin="0,0,0,12"
                    Padding="12,8"
                    CornerRadius="{StaticResource ControlRadius}"
                    Background="{StaticResource ChipFillBrush}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotNullOrEmptyToVis}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Candidate cards -->
            <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="16"
                                CornerRadius="{StaticResource ControlRadius}"
                                Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: metadata -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{Binding CreatorName, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding SeriesTitle, Mode=OneWay}" />
                                    </TextBlock>
                                    <!-- Size / Duration / Resolution chips -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Padding="6,2" CornerRadius="4"
                                                Background="{StaticResource ChipFillBrush}"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="{Binding SizeText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="4"
                                                Background="{StaticResource ChipFillBrush}"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="{Binding DurationText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="4"
                                                Background="{StaticResource ChipFillBrush}">
                                            <TextBlock Text="{Binding ResolutionText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FilePath}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Opacity="0.6" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Right: actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ui:Button Command="{Binding PlayCommand}"
                                               Style="{StaticResource SecondaryButton}"
                                               Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" Margin="0,0,4,0" />
                                            <TextBlock Text="Play" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Command="{Binding KeepCommand}"
                                               Style="{StaticResource PrimaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,4,0" />
                                            <TextBlock Text="Keep this" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
