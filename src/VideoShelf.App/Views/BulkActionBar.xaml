<UserControl x:Class="VideoShelf.App.Views.BulkActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Opaque bottom bar — never transparent (M10 trap: transparency renders black
         if it ever overlaps the player HWND; keep solid even in non-overlapping contexts). -->
    <Border Background="{StaticResource PlayerPanelBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Count label -->
                <ColumnDefinition Width="Auto" />
                <!-- Action buttons (fills) -->
                <ColumnDefinition Width="*" />
                <!-- Tag entry -->
                <ColumnDefinition Width="Auto" />
                <!-- Clear / dismiss -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- "N selected" label -->
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedCountLabel}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <!-- Action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Mark watched -->
                <ui:Button Command="{Binding MarkWatchedCommand}"
                           ToolTip="Mark watched"
                           Style="{StaticResource TertiaryButton}"
                           Padding="10,4" Margin="0,0,4,0"
                           AutomationProperties.Name="Mark selected watched">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Eye24" Margin="0,0,4,0" />
                        <TextBlock Text="Watched" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Mark unwatched -->
                <ui:Button Command="{Binding MarkUnwatchedCommand}"
                           ToolTip="Mark unwatched"
                           Style="{StaticResource TertiaryButton}"
                           Padding="10,4" Margin="0,0,4,0"
                           AutomationProperties.Name="Mark selected unwatched">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="EyeOff24" Margin="0,0,4,0" />
                        <TextBlock Text="Unwatched" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Add to watchlist -->
                <ui:Button Command="{Binding AddToWatchlistCommand}"
                           ToolTip="Add to Watch later"
                           Style="{StaticResource TertiaryButton}"
                           Padding="10,4" Margin="0,0,4,0"
                           AutomationProperties.Name="Add selected to watchlist">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,4,0" />
                        <TextBlock Text="Watch later" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Favorite -->
                <ui:Button Command="{Binding AddFavoriteCommand}"
                           ToolTip="Add to Favorites"
                           Style="{StaticResource TertiaryButton}"
                           Padding="10,4" Margin="0,0,4,0"
                           AutomationProperties.Name="Add selected to favorites">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Heart24" Margin="0,0,4,0" />
                        <TextBlock Text="Favorite" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Add to queue -->
                <ui:Button Command="{Binding AddToQueueCommand}"
                           ToolTip="Add to play queue"
                           Style="{StaticResource TertiaryButton}"
                           Padding="10,4" Margin="0,0,4,0"
                           AutomationProperties.Name="Add selected to queue">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="List24" Margin="0,0,4,0" />
                        <TextBlock Text="Queue" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Rename (cross-series template rename — creator-grid selection only) -->
                <ui:Button ToolTip="Rename with template"
                           Style="{StaticResource TertiaryButton}"
                           Padding="10,4"
                           AutomationProperties.Name="Rename selected series with template"
                           x:Name="RenameButton">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Edit24" Margin="0,0,4,0" />
                        <TextBlock Text="Rename…" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

            </StackPanel>

            <!-- Inline tag entry: TextBox + Apply button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <ui:TextBox Text="{Binding PendingTag, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Add tag…"
                            Width="140"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="Tag to apply to selection">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ApplyTagCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button Command="{Binding ApplyTagCommand}"
                           ToolTip="Apply tag"
                           Style="{StaticResource TertiaryButton}"
                           Padding="10,4"
                           AutomationProperties.Name="Apply tag to selection">
                    <ui:SymbolIcon Symbol="Tag24" />
                </ui:Button>
            </StackPanel>

            <!-- Clear (exit selection / dismiss bar) -->
            <ui:Button Grid.Column="3"
                       ToolTip="Clear selection"
                       Style="{StaticResource TertiaryButton}"
                       Padding="8,4"
                       AutomationProperties.Name="Clear selection"
                       x:Name="ClearButton">
                <ui:SymbolIcon Symbol="Dismiss24" />
            </ui:Button>

        </Grid>
    </Border>
</UserControl>
