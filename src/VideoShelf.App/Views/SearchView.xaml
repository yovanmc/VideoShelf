<UserControl x:Class="VideoShelf.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:VideoShelf.App.Views"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Result summary line: "2 creators · 1 series · 4 videos" -->
            <TextBlock Text="{Binding ResultSummary}" Margin="0,0,0,12"
                       Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"
                       Style="{StaticResource Caption}"/>

            <!-- Creator results (non-selectable; selection on video group only) -->
            <TextBlock Text="Creators" Style="{StaticResource TypeRailHeader}" Margin="0,0,0,8"
                       Visibility="{Binding HasCreatorResults, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding CreatorResults}"
                          Visibility="{Binding HasCreatorResults, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><views:CreatorCard Margin="0,0,12,12"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Series results: non-selectable wrap panel, same visual style as creator cards -->
            <TextBlock Text="Series" Style="{StaticResource TypeRailHeader}" Margin="0,16,0,8"
                       Visibility="{Binding HasSeriesResults, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding SeriesResults}"
                          Visibility="{Binding HasSeriesResults, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding OpenCommand}"
                                Width="{StaticResource CardWidth}"
                                Padding="0" Margin="0,0,12,12"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                FocusVisualStyle="{StaticResource AppFocusVisual}">
                            <StackPanel>
                                <Border CornerRadius="{StaticResource CardImageRadius}"
                                        Background="{StaticResource ThumbPlaceholderBrush}"
                                        Height="{StaticResource CardThumbHeight}" ClipToBounds="True">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="MoviesAndTv24"
                                                       FontSize="24" Opacity="0.35"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Cover}"
                                               Style="{StaticResource ThumbnailImage}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,8,2,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EpisodeCountLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="2,1,2,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Video results: virtualized, selectable -->
            <StackPanel Visibility="{Binding HasVideoResults, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                    <TextBlock Text="Videos" Style="{StaticResource TypeRailHeader}" VerticalAlignment="Center"/>
                    <!-- G7: ToolTip on Select toggle -->
                    <ToggleButton Content="Select"
                                  IsChecked="{Binding Selection.IsSelectionMode, Mode=TwoWay}"
                                  Style="{StaticResource ChipToggle}"
                                  ToolTip="Select multiple"
                                  Margin="12,0,0,0" />
                    <Button Content="Select all"
                            Visibility="{Binding Selection.IsSelectionMode, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding Selection.SelectAllCommand}"
                            CommandParameter="{Binding VideoResults}"
                            Margin="8,0,0,0" Padding="10,4"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Clear"
                            Visibility="{Binding Selection.IsSelectionMode, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding Selection.ClearSelectionCommand}"
                            Margin="4,0,0,0" Padding="10,4"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <ListBox ItemsSource="{Binding VideoResults}"
                         SelectionMode="Extended"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Style="{StaticResource PlainListBox}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel SpacingMode="Uniform" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <views:VideoCard
                                    IsHitTestVisible="{Binding DataContext.Selection.IsSelectionMode,
                                        RelativeSource={RelativeSource AncestorType=ListBox},
                                        Converter={StaticResource InverseBoolToBool}}" />
                                <CheckBox Width="{StaticResource CheckboxSize}"
                                          Height="{StaticResource CheckboxSize}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Margin="6,6,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding DataContext.Selection.IsSelectionMode,
                                              RelativeSource={RelativeSource AncestorType=ListBox},
                                              Converter={StaticResource BoolToVisibility}}"
                                          />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- No-results state: shown when query is non-empty and all result groups are empty -->
            <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,8"
                       Visibility="{Binding NoResults, Converter={StaticResource BoolToVisibility}}">
                <Run Text="No creators, series, or videos match &#x201C;"/>
                <Run Text="{Binding Query}"/>
                <Run Text="&#x201D;."/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
