<UserControl x:Class="VideoShelf.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:VideoShelf.App.Views.Controls"
             xmlns:vm="clr-namespace:VideoShelf.App.ViewModels"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
            <conv:FractionToWidth x:Key="FractionToWidth" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- Skeleton loading overlay -->
        <controls:SkeletonPanel Margin="24,8,24,0"
                                VerticalAlignment="Top"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                Animate="{Binding DataContext.AnimationsEnabled,
                                          RelativeSource={RelativeSource AncestorType=Window}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Watch history" Style="{StaticResource TypeRailHeader}" Margin="0,0,0,16" FontSize="22"/>

            <!-- G8: Empty state copy -->
            <TextBlock Text="Videos you watch will appear here."
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,40">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Date-grouped history: one section per group (Today / This week / Older) -->
            <ItemsControl ItemsSource="{Binding Groups}"
                          Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryGroupViewModel}">
                        <StackPanel Margin="0,0,0,16">
                            <!-- Group header label -->
                            <TextBlock Text="{Binding Label}"
                                       Style="{StaticResource TypeEyebrow}"
                                       Margin="0,0,0,8" />

                            <!-- Rows in this group -->
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                                        <Border Background="{StaticResource SubtleFillBrush}"
                                                CornerRadius="{StaticResource ControlRadius}"
                                                Margin="0,0,0,4"
                                                Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Thumbnail -->
                                                    <ColumnDefinition Width="80" />
                                                    <!-- Title + progress + date -->
                                                    <ColumnDefinition Width="*" />
                                                    <!-- Play button -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Thumbnail -->
                                                <Border Grid.Column="0"
                                                        CornerRadius="{StaticResource ControlRadius}"
                                                        Background="{StaticResource ThumbPlaceholderBrush}"
                                                        Height="45"
                                                        ClipToBounds="True"
                                                        Margin="0,0,8,0">
                                                    <Image Source="{Binding Cover}"
                                                           Style="{StaticResource ThumbnailImage}"
                                                           Stretch="UniformToFill" />
                                                </Border>

                                                <!-- Title + progress bar + date -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource TypeBody}" />
                                                    <!-- Resume progress track (visible only when HasProgress) -->
                                                    <Border Height="3" CornerRadius="1" Margin="0,4,0,2"
                                                            Background="{StaticResource ThumbPlaceholderBrush}"
                                                            Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                                                        <Border HorizontalAlignment="Left" CornerRadius="1"
                                                                Background="{StaticResource AccentBrush}"
                                                                Width="{Binding ProgressFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=160}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding WatchedAt}"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="11" />
                                                </StackPanel>

                                                <!-- Play button -->
                                                <ui:Button Grid.Column="2"
                                                           Command="{Binding PlayCommand}"
                                                           Style="{StaticResource TertiaryButton}"
                                                           ToolTip="Play"
                                                           VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Play24" />
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
