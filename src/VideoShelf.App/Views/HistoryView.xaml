<UserControl x:Class="VideoShelf.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:VideoShelf.App.Views.Controls"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- Skeleton loading overlay -->
        <controls:SkeletonPanel Margin="24,8,24,0"
                                VerticalAlignment="Top"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                Animate="{Binding DataContext.AnimationsEnabled,
                                          RelativeSource={RelativeSource AncestorType=Window}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Watch history" Style="{StaticResource TypeRailHeader}" Margin="0,0,0,16" FontSize="22"/>

            <!-- Empty state: visible when HasHistory is false -->
            <TextBlock Text="No watch history yet — episodes you finish will appear here."
                       Opacity="0.7" Margin="0,40">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- History list -->
            <ItemsControl ItemsSource="{Binding Entries}"
                          Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SubtleFillBrush}"
                                CornerRadius="{StaticResource ControlRadius}"
                                Margin="0,0,0,4"
                                Padding="12,8">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right"
                                           Command="{Binding PlayCommand}"
                                           Style="{StaticResource TertiaryButton}"
                                           ToolTip="Play">
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:Button>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding WatchedAt}"
                                           Opacity="0.6" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
