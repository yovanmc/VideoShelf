<UserControl x:Class="VideoShelf.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters"
             xmlns:vm="clr-namespace:VideoShelf.App.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
            <conv:FractionToWidth  x:Key="FractionToWidth" />

            <!-- Bar-track style: background rail -->
            <Style x:Key="BarTrack" TargetType="Border">
                <Setter Property="Height" Value="12" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="{StaticResource ThumbPlaceholderBrush}" />
                <Setter Property="Margin" Value="0,0,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Page header -->
            <TextBlock Text="Insights" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4" />
            <TextBlock Text="An offline snapshot of your library. All counts come straight from your local database."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                       Margin="0,0,0,24" />

            <!-- ── Empty-library state ──────────────────────────────────── -->
            <Border Padding="48" CornerRadius="{StaticResource ControlRadius}"
                    Background="{StaticResource CardSurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="DataPie24" FontSize="40"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="No data yet"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4" />
                    <TextBlock Text="Add a folder and scan your library to see insights here."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Everything below only shows when HasData ────────────── -->
            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">

                <!-- ── Stat cards ─────────────────────────────────────── -->
                <TextBlock Text="OVERVIEW" Style="{StaticResource SectionHeader}"
                           Margin="{StaticResource SectionGap}" />

                <!-- Row 1: playback stats -->
                <UniformGrid Rows="1" Columns="4" Margin="0,8,0,0">
                    <Border Margin="0,0,8,8" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Total videos" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TotalVideosText}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,8" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Watched" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding WatchedText}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,8" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Completion" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CompletionText}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,8" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Hours watched" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TotalHoursText}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Row 2: library composition -->
                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,0">
                    <Border Margin="0,0,8,8" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Creators" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CreatorsText}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,8" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Series" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SeriesText}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,8" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Standalones" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding StandalonesText}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ── Watch activity by month ─────────────────────────── -->
                <!--
                     Bar width = Fraction * 560 (track width of 560 px inside a 900-MaxWidth
                     card with 16px padding each side and 140px label column + 36px value column
                     gap: 900 - 32 - 140 - 8 - 36 = 684, rounded to 560 for conservative fit).
                -->
                <StackPanel Margin="{StaticResource SectionGap}"
                            Visibility="{Binding HasWatchActivity, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="WATCH ACTIVITY — last 12 months"
                               Style="{StaticResource SectionHeader}" />
                    <Border Margin="0,8,0,0" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <ItemsControl ItemsSource="{Binding WatchActivityBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InsightsBarItem}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource BarTrack}">
                                            <Border HorizontalAlignment="Left" CornerRadius="3"
                                                    Background="{StaticResource AccentBrush}"
                                                    Width="{Binding Fraction,
                                                           Converter={StaticResource FractionToWidth},
                                                           ConverterParameter=560}" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ValueText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ── Two-column lower section ───────────────────────── -->
                <!--
                     Each half is ~(900-16)/2 = 442px wide; card padding 16px each side → track ~370px.
                     Labels: rating 52px + gap 8 + value 32 → track ≈ 330px. Use 300 for safety.
                -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Rating distribution -->
                    <StackPanel Grid.Column="0"
                                Visibility="{Binding HasRatings, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="RATINGS DISTRIBUTION"
                                   Style="{StaticResource SectionHeader}" />
                        <Border Margin="0,8,0,0" Padding="16"
                                CornerRadius="{StaticResource ControlRadius}"
                                Background="{StaticResource CardSurfaceBrush}">
                            <ItemsControl ItemsSource="{Binding RatingBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InsightsBarItem}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource BarTrack}">
                                                <Border HorizontalAlignment="Left" CornerRadius="3"
                                                        Background="{StaticResource WarningBrush}"
                                                        Width="{Binding Fraction,
                                                               Converter={StaticResource FractionToWidth},
                                                               ConverterParameter=300}" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ValueText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Top tags -->
                    <StackPanel Grid.Column="2"
                                Visibility="{Binding HasTopTags, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="TOP TAGS (watched / total)"
                                   Style="{StaticResource SectionHeader}" />
                        <Border Margin="0,8,0,0" Padding="16"
                                CornerRadius="{StaticResource ControlRadius}"
                                Background="{StaticResource CardSurfaceBrush}">
                            <ItemsControl ItemsSource="{Binding TopTagBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InsightsBarItem}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Style="{StaticResource BarTrack}">
                                                <Border HorizontalAlignment="Left" CornerRadius="3"
                                                        Background="{StaticResource AccentBrush}"
                                                        Width="{Binding Fraction,
                                                               Converter={StaticResource FractionToWidth},
                                                               ConverterParameter=260}" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ValueText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── Top creators by watched ─────────────────────────── -->
                <StackPanel Margin="{StaticResource SectionGap}"
                            Visibility="{Binding HasTopCreators, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="TOP CREATORS — by episodes watched"
                               Style="{StaticResource SectionHeader}" />
                    <Border Margin="0,8,0,0" Padding="16"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{StaticResource CardSurfaceBrush}">
                        <ItemsControl ItemsSource="{Binding TopCreatorBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InsightsBarItem}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Style="{StaticResource BarTrack}">
                                            <Border HorizontalAlignment="Left" CornerRadius="3"
                                                    Background="{StaticResource AccentBrush}"
                                                    Width="{Binding Fraction,
                                                           Converter={StaticResource FractionToWidth},
                                                           ConverterParameter=560}" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ValueText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
