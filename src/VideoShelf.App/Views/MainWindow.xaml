<ui:FluentWindow x:Class="VideoShelf.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:VideoShelf.App.ViewModels"
                 xmlns:views="clr-namespace:VideoShelf.App.Views"
                 xmlns:conv="clr-namespace:VideoShelf.App.Converters"
                 xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
                 Title="VideoShelf"
                 Width="1180"
                 Height="760"
                 MinWidth="900"
                 MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.InputBindings>
        <!-- Ctrl+K opens the command palette.
             PreviewKeyDown in code-behind is the reliable fallback for when
             the persistent search TextBox has focus and absorbs KeyBindings. -->
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding OpenCommandPaletteCommand}" />
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tokens merged per-view so the window parses self-contained. -->
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
            <conv:MissingToOpacity x:Key="MissingToOpacity" />
            <conv:SortModeToIndex x:Key="SortModeToIndex" />
            <conv:EnumToVisibility x:Key="EnumToVis" />
            <conv:EnumSetToVisibility x:Key="EnumSetToVis" />
            <conv:InvertBool x:Key="InverseBoolToBool" />
            <conv:StringToSymbolConverter x:Key="StringToSymbol" />
            <conv:NotNullOrEmptyToVisibility x:Key="NotNullOrEmptyToVis" />
            <conv:DensityToCardWidth x:Key="DensityToCardWidth" />
            <conv:DensityToCardThumbHeight x:Key="DensityToCardThumbHeight" />
            <conv:ViewModeToVisibility x:Key="ViewModeToVis" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="VideoShelf" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top nav bar: Back / Home / Browse / Search / Settings -->
            <Border Grid.Row="0" Background="{StaticResource SubtleFillBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Command="{Binding GoBackCommand}"
                               Margin="0,0,8,0" ToolTip="Back"
                               Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource TertiaryButton}">
                        <ui:SymbolIcon Symbol="ArrowLeft24" />
                    </ui:Button>
                    <Grid Grid.Column="1" Margin="0,0,4,0">
                        <ui:Button Command="{Binding ShowHomeCommand}"
                                   Style="{StaticResource TertiaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" Margin="0,0,4,0" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="8,0" Background="{StaticResource AccentBrush}"
                                Visibility="{Binding CurrentView, Converter={StaticResource EnumSetToVis}, ConverterParameter=Home}" />
                    </Grid>
                    <Grid Grid.Column="2" Margin="0,0,4,0">
                        <ui:Button Command="{Binding ShowBrowseCommand}"
                                   Style="{StaticResource TertiaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Apps24" Margin="0,0,4,0" />
                                <TextBlock Text="Browse" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="8,0" Background="{StaticResource AccentBrush}"
                                Visibility="{Binding CurrentView, Converter={StaticResource EnumSetToVis}, ConverterParameter='Browse,SectionDetail,RenameTool'}" />
                    </Grid>
                    <!-- Library menu: links to SmartViews, Playlists, Watchlist, Favorites, History, SurpriseMe -->
                    <Grid Grid.Column="3" Margin="0,0,4,0">
                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Padding="8,6">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Library24" Margin="0,0,4,0" />
                                        <TextBlock Text="Library" VerticalAlignment="Center" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Header="Smart Views" Command="{Binding ShowSmartViewsCommand}" />
                                <MenuItem Header="Playlists"   Command="{Binding ShowPlaylistsCommand}" />
                                <MenuItem Header="Watch later" Command="{Binding ShowWatchlistCommand}" />
                                <MenuItem Header="Favorites"   Command="{Binding ShowFavoritesCommand}" />
                                <MenuItem Header="History"     Command="{Binding ShowHistoryCommand}" />
                                <Separator />
                                <MenuItem Header="Surprise me 🎲" Command="{Binding SurpriseMeCommand}" />
                            </MenuItem>
                        </Menu>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="8,0" Background="{StaticResource AccentBrush}"
                                Visibility="{Binding CurrentView, Converter={StaticResource EnumSetToVis}, ConverterParameter='SmartViews,Playlists,Watchlist,Favorites,History'}" />
                    </Grid>
                    <ui:TextBox Grid.Column="4" PlaceholderText="Search creators and videos…" Margin="24,0"
                                Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Up next nav button: visible when a queue is active -->
                    <Grid Grid.Column="5" Margin="0,0,4,0">
                        <ui:Button Command="{Binding ShowQueueCommand}"
                                   Visibility="{Binding PlayQueue.HasQueue, Converter={StaticResource BoolToVisibility}}"
                                   Style="{StaticResource TertiaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="List24" Margin="0,0,4,0" />
                                <TextBlock Text="Up next" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="8,0" Background="{StaticResource AccentBrush}"
                                Visibility="{Binding CurrentView, Converter={StaticResource EnumSetToVis}, ConverterParameter=Queue}"/>
                    </Grid>
                    <Grid Grid.Column="6">
                        <ui:Button Command="{Binding ShowSettingsCommand}" ToolTip="Settings"
                                   Style="{StaticResource TertiaryButton}">
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:Button>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="8,0" Background="{StaticResource AccentBrush}"
                                Visibility="{Binding CurrentView, Converter={StaticResource EnumSetToVis}, ConverterParameter=Settings}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Main content row (full-width; sidebar removed) -->
            <Grid Grid.Row="1">

                <!-- Nav-gated content hosts -->

                <!-- Home view — DiscoveryView -->
                <views:DiscoveryView DataContext="{Binding Discovery}"
                                     Visibility="{Binding DataContext.CurrentView,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource EnumToVis},
                                         ConverterParameter=Home}" />

                <!-- Browse view — virtualized, selectable creator grid -->
                <Grid Visibility="{Binding DataContext.CurrentView,
                          RelativeSource={RelativeSource AncestorType=Window},
                          Converter={StaticResource EnumToVis},
                          ConverterParameter=Browse}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Browse page header: Select + filter + density + view-mode toggles -->
                    <StackPanel Grid.Row="0" Margin="16,12,16,4">
                        <!-- Row 1: selection controls + density/view toggles -->
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="Select"
                                          IsChecked="{Binding Creators.Selection.IsSelectionMode, Mode=TwoWay}"
                                          Style="{StaticResource ChipToggle}"
                                          AutomationProperties.Name="Toggle selection mode" />
                            <Button Content="Select all"
                                    Visibility="{Binding Creators.Selection.IsSelectionMode, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding Creators.Selection.SelectAllCommand}"
                                    CommandParameter="{Binding Creators.Creators}"
                                    Margin="8,0,0,0" Padding="10,4"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    AutomationProperties.Name="Select all creators" />
                            <Button Content="Clear"
                                    Visibility="{Binding Creators.Selection.IsSelectionMode, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding Creators.Selection.ClearSelectionCommand}"
                                    Margin="4,0,0,0" Padding="10,4"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    AutomationProperties.Name="Clear selection" />
                            <!-- Spacer -->
                            <Border Width="16" />
                            <!-- Filter toggle -->
                            <ToggleButton IsChecked="{Binding Creators.IsFilterVisible, Mode=TwoWay}"
                                          Style="{StaticResource ChipToggle}"
                                          ToolTip="Filter creators"
                                          AutomationProperties.Name="Toggle filter bar">
                                <ui:SymbolIcon Symbol="Filter24" />
                            </ToggleButton>
                            <!-- Density group: Compact / Normal / Spacious -->
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,4,0"
                                              ToolTip="Compact" AutomationProperties.Name="Compact density"
                                              IsChecked="{Binding Creators.Density,
                                                  Converter={StaticResource EnumToVis},
                                                  ConverterParameter=Compact, Mode=OneWay}"
                                              Command="{Binding Creators.SetDensityCompactCommand}">
                                    <ui:SymbolIcon Symbol="TextGrammarArrowLeft24" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,4,0"
                                              ToolTip="Normal" AutomationProperties.Name="Normal density"
                                              IsChecked="{Binding Creators.Density,
                                                  Converter={StaticResource EnumToVis},
                                                  ConverterParameter=Normal, Mode=OneWay}"
                                              Command="{Binding Creators.SetDensityNormalCommand}">
                                    <ui:SymbolIcon Symbol="Grid24" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ChipToggle}"
                                              ToolTip="Spacious" AutomationProperties.Name="Spacious density"
                                              IsChecked="{Binding Creators.Density,
                                                  Converter={StaticResource EnumToVis},
                                                  ConverterParameter=Spacious, Mode=OneWay}"
                                              Command="{Binding Creators.SetDensitySpaciousCommand}">
                                    <ui:SymbolIcon Symbol="TextGrammarArrowRight24" />
                                </ToggleButton>
                            </StackPanel>
                            <!-- View-mode: Grid / List -->
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,4,0"
                                              ToolTip="Grid view" AutomationProperties.Name="Grid view"
                                              IsChecked="{Binding Creators.ViewMode,
                                                  Converter={StaticResource EnumToVis},
                                                  ConverterParameter=Grid, Mode=OneWay}"
                                              Command="{Binding Creators.SetViewModeGridCommand}">
                                    <ui:SymbolIcon Symbol="AppsList24" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ChipToggle}"
                                              ToolTip="List view" AutomationProperties.Name="List view"
                                              IsChecked="{Binding Creators.ViewMode,
                                                  Converter={StaticResource EnumToVis},
                                                  ConverterParameter=List, Mode=OneWay}"
                                              Command="{Binding Creators.SetViewModeListCommand}">
                                    <ui:SymbolIcon Symbol="List24" />
                                </ToggleButton>
                            </StackPanel>
                        </StackPanel>
                        <!-- Row 2: ephemeral filter bar (collapsed by default) -->
                        <Grid Margin="0,6,0,0"
                              Visibility="{Binding Creators.IsFilterVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding Creators.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Filter creators…"
                                        AutomationProperties.Name="Filter creators" />
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Margin="4,0,0,0" Padding="8,4"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding Creators.ClearFilterCommand}"
                                    ToolTip="Clear filter"
                                    AutomationProperties.Name="Clear filter" />
                        </Grid>
                    </StackPanel>

                    <!-- Grid view: VirtualizingWrapPanel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Creators.ViewMode, Converter={StaticResource ViewModeToVis}, ConverterParameter=Grid}">
                        <ListBox x:Name="CreatorsGridListBox"
                                 ItemsSource="{Binding Creators.Creators}"
                                 SelectionMode="Extended"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Style="{StaticResource PlainListBox}"
                                 Margin="16,0,16,16">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel SpacingMode="Uniform" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <!-- Density: bind card container width from the ListBox DataContext -->
                                    <Setter Property="Width" Value="{Binding DataContext.Creators.Density,
                                        RelativeSource={RelativeSource AncestorType=ListBox},
                                        Converter={StaticResource DensityToCardWidth}}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <views:CreatorCard
                                            IsHitTestVisible="{Binding DataContext.Creators.Selection.IsSelectionMode,
                                                RelativeSource={RelativeSource AncestorType=ListBox},
                                                Converter={StaticResource InverseBoolToBool}}" />
                                        <CheckBox Width="{StaticResource CheckboxSize}"
                                                  Height="{StaticResource CheckboxSize}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Margin="6,6,0,0" IsHitTestVisible="False"
                                                  Visibility="{Binding DataContext.Creators.Selection.IsSelectionMode,
                                                      RelativeSource={RelativeSource AncestorType=ListBox},
                                                      Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Select this creator" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- List view: VirtualizingStackPanel -->
                    <ListBox x:Name="CreatorsListListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Creators.Creators}"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource PlainListBox}"
                             Margin="16,0,16,16"
                             Visibility="{Binding Creators.ViewMode, Converter={StaticResource ViewModeToVis}, ConverterParameter=List}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <!-- Override margin for list rows (no card gap) -->
                                <Setter Property="Margin" Value="0,0,0,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Compact list row: thumbnail + name + count + context menu -->
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Thumbnail slot -->
                                    <Border Grid.Column="0" CornerRadius="{StaticResource ControlRadius}"
                                            Background="{StaticResource ThumbPlaceholderBrush}"
                                            Margin="0,2,8,2" ClipToBounds="True">
                                        <Image Source="{Binding ImagePath, IsAsync=True}"
                                               Style="{StaticResource ThumbnailImage}" />
                                    </Border>
                                    <!-- Name + count -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TypeBody}" />
                                        <TextBlock Text="{Binding VideoCountLabel}"
                                                   Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <!-- Open button -->
                                    <Button Grid.Column="2" Command="{Binding OpenCommand}"
                                            IsHitTestVisible="{Binding DataContext.Creators.Selection.IsSelectionMode,
                                                RelativeSource={RelativeSource AncestorType=ListBox},
                                                Converter={StaticResource InverseBoolToBool}}"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="8,4" Cursor="Hand"
                                            AutomationProperties.Name="Open creator">
                                        <ui:SymbolIcon Symbol="ChevronRight24" />
                                    </Button>
                                    <!-- Selection checkbox overlay -->
                                    <CheckBox Grid.Column="0" Width="{StaticResource CheckboxSize}"
                                              Height="{StaticResource CheckboxSize}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="4,0,0,0" IsHitTestVisible="False"
                                              Visibility="{Binding DataContext.Creators.Selection.IsSelectionMode,
                                                  RelativeSource={RelativeSource AncestorType=ListBox},
                                                  Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Select this creator" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Section detail view -->
                <views:SectionDetailView DataContext="{Binding SectionDetail}"
                                         Visibility="{Binding DataContext.CurrentView,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource EnumToVis},
                                             ConverterParameter=SectionDetail}" />

                <!-- Rename tool view -->
                <views:RenameToolView DataContext="{Binding RenameTool}"
                                      Visibility="{Binding DataContext.CurrentView,
                                          RelativeSource={RelativeSource AncestorType=Window},
                                          Converter={StaticResource EnumToVis},
                                          ConverterParameter=RenameTool}" />

                <!-- Search view -->
                <views:SearchView DataContext="{Binding Search}"
                                  Visibility="{Binding DataContext.CurrentView,
                                      RelativeSource={RelativeSource AncestorType=Window},
                                      Converter={StaticResource EnumToVis},
                                      ConverterParameter=Search}" />

                <!-- Settings view -->
                <views:SettingsView
                    Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToVis}, ConverterParameter=Settings}" />

                <!-- Queue page view -->
                <views:QueuePageView
                    Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToVis}, ConverterParameter=Queue}" />

                <!-- Smart views management page -->
                <views:SmartViewsView DataContext="{Binding SmartViews}"
                    Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToVis}, ConverterParameter=SmartViews}" />

                <!-- Favorites page -->
                <views:FavoritesView DataContext="{Binding Favorites}"
                    Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToVis}, ConverterParameter=Favorites}" />

                <!-- Watchlist (Watch later) page -->
                <views:WatchlistView DataContext="{Binding Watchlist}"
                    Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToVis}, ConverterParameter=Watchlist}" />

                <!-- Playlists page -->
                <views:PlaylistsView DataContext="{Binding Playlists}"
                    Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToVis}, ConverterParameter=Playlists}" />

                <!-- History page -->
                <views:HistoryView DataContext="{Binding History}"
                    Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToVis}, ConverterParameter=History}" />

                <!-- Bulk-action bar: docked at the bottom of the content area.
                     Visible when the Browse creator selection is non-empty.
                     Overlays the bottom of content (not the nav bar). -->
                <views:BulkActionBar x:Name="BulkActionBarHost"
                                     DataContext="{Binding BulkBar}"
                                     VerticalAlignment="Bottom"
                                     Visibility="{Binding DataContext.BulkBarVisible,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVisibility}}" />

                <!-- Empty-state overlay: shown when no sources added yet.
                     Sits before PlayerHost in z-order; IsLibraryEmpty implies no playback so
                     ordering is safe — overlay is last content-host child, before PlayerHost. -->
                <Border Background="{StaticResource ApplicationBackgroundBrush}"
                        Visibility="{Binding DataContext.IsLibraryEmpty, RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="No sources yet" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Add a folder of videos to start building your library."
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" Margin="0,8,0,16" />
                        <ui:Button Content="Add a source" HorizontalAlignment="Center"
                                   Command="{Binding DataContext.Sources.AddSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- Immersive player host: overlays the ENTIRE window while playing. Content is set in code-behind
             only while playing, so the VideoView (and its airspace overlay HWND) is torn down when hidden —
             this is the fix for the transport-bar bleed onto non-player views. -->
        <ContentControl x:Name="PlayerHost" Grid.Row="0" Grid.RowSpan="2">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <!-- In-window PiP: the host itself becomes a small corner panel, so the rest of
                             the window is ordinary (fully visible) app content behind it. -->
                        <DataTrigger Binding="{Binding IsPictureInPicture}" Value="True">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="Width" Value="360" />
                            <Setter Property="Height" Value="203" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- ── Command palette overlay (Ctrl+K) ────────────────────────────
             Spans the full window (both rows) so it floats above everything.
             Gated by IsCommandPaletteOpen. Opaque card avoids transparency-
             renders-black trap if the player is active in PiP mode.
             Esc / scrim click close the palette. -->
        <Grid x:Name="CommandPaletteOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}"
              IsHitTestVisible="{Binding IsCommandPaletteOpen}">

            <!-- Dimmed scrim — clicking it closes the palette. -->
            <Border Background="#99000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CommandPalette.CloseCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- Centered opaque card -->
            <Border Width="620"
                    MaxHeight="480"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#FF1E1E2E"
                    CornerRadius="10"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1">
                <Grid DataContext="{Binding CommandPalette}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search input row -->
                    <Grid Grid.Row="0" Margin="12,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" Margin="6,0,8,0"
                                       VerticalAlignment="Center" Opacity="0.7" />
                        <TextBox x:Name="PaletteSearchBox"
                                 Grid.Column="1"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#FFFFFFFF"
                                 CaretBrush="#FFFFFFFF"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape"  Command="{Binding CloseCommand}" />
                                <KeyBinding Key="Return"  Command="{Binding ExecuteSelectedCommand}" />
                                <KeyBinding Key="Up"      Command="{Binding MoveUpCommand}" />
                                <KeyBinding Key="Down"    Command="{Binding MoveDownCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1" Background="#22FFFFFF" Margin="12,0" />

                    <!-- Result list -->
                    <ListBox Grid.Row="2"
                             x:Name="PaletteListBox"
                             ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             Style="{StaticResource PlainListBox}"
                             MaxHeight="380"
                             Margin="6,6,6,6"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteItemViewModel}">
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="{Binding IconSymbol, Converter={StaticResource StringToSymbol}}"
                                                   VerticalAlignment="Center" Opacity="0.85" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Label}" FontSize="14" />
                                        <TextBlock Text="{Binding SubLabel}" FontSize="11" Opacity="0.6"
                                                   Visibility="{Binding SubLabel, Converter={StaticResource NotNullOrEmptyToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                                <!-- Double-click or Enter executes; single-click selects -->
                                <EventSetter Event="MouseDoubleClick"
                                             Handler="PaletteItem_DoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
