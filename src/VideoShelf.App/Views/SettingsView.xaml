<UserControl x:Class="VideoShelf.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters"
             xmlns:views="clr-namespace:VideoShelf.App.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
            <conv:NotNullOrEmptyToVisibility x:Key="NotNullOrEmptyToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">

            <!-- Page title -->
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- LIBRARY section -->
            <TextBlock Text="LIBRARY" Style="{StaticResource SectionHeader}" Margin="{StaticResource SectionGap}" />

            <!-- Actions row -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <ui:Button Content="Add source"
                           Command="{Binding Sources.AddSourceCommand}"
                           Style="{StaticResource PrimaryButton}" />
                <ui:Button Content="Scan"
                           Margin="8,0,0,0"
                           Command="{Binding ScanAndReloadCommand}"
                           Style="{StaticResource SecondaryButton}" />
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="20" Height="20"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                <!-- C2: honest scan phase label shown while scanning (phase labels, not fabricated counts) -->
                <TextBlock Text="{Binding ScanStatusText}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Settings.LastScanText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- Scan-diff summary (shown only when a scan summary is available) -->
            <Border Margin="0,4,0,8"
                    Padding="12,8"
                    CornerRadius="{StaticResource ControlRadius}"
                    Background="{DynamicResource ChipFillBrush}"
                    Visibility="{Binding Settings.LastScanSummaryText, Converter={StaticResource NotNullOrEmptyToVis}}">
                <TextBlock Text="{Binding Settings.LastScanSummaryText}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12" />
            </Border>

            <!-- Sources list -->
            <ItemsControl ItemsSource="{Binding Sources.Sources}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <ui:Button DockPanel.Dock="Right"
                                       Content="Remove"
                                       Command="{Binding DataContext.Sources.RemoveSourceCommand,
                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"
                                       Style="{StaticResource SecondaryButton}"
                                       MinWidth="44" MinHeight="44" />
                            <TextBlock Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Undo remove: visible only after a source was removed this session -->
            <ui:Button Content="Undo remove source"
                       Command="{Binding Sources.UndoRemoveCommand}"
                       Style="{StaticResource SecondaryButton}"
                       Margin="0,0,0,8"
                       MinWidth="44" MinHeight="44"
                       Visibility="{Binding Sources.CanUndoRemove, Converter={StaticResource BoolToVisibility}}" />

            <!-- PLAYBACK section -->
            <TextBlock Text="PLAYBACK" Style="{StaticResource SectionHeader}" Margin="{StaticResource SectionGap}" />
            <CheckBox Margin="0,8,0,0"
                      Content="Auto-play next episode"
                      IsChecked="{Binding Settings.AutoAdvanceEpisodes}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
