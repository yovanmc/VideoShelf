<UserControl x:Class="VideoShelf.App.Views.VideoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vis="clr-namespace:VideoShelf.App.Visuals">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <vis:NullToVisibilityConverter x:Key="NullToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Button Command="{Binding PlayCommand}" Margin="0,0,12,0" Padding="0"
            Background="Transparent" BorderThickness="0" Width="{StaticResource CardWidth}" Cursor="Hand"
            HorizontalContentAlignment="Stretch"
            FocusVisualStyle="{StaticResource AppFocusVisual}"
            RenderTransformOrigin="0.5,0.5">
        <Button.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                              Color="#000000" Opacity="0"/>
        </Button.Effect>
        <Button.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Button.RenderTransform>
        <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1.03" Duration="{StaticResource AnimFast}">
                                        <DoubleAnimation.EasingFunction><StaticResource ResourceKey="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1.03" Duration="{StaticResource AnimFast}">
                                        <DoubleAnimation.EasingFunction><StaticResource ResourceKey="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                     To="0.45" Duration="{StaticResource AnimFast}">
                                        <DoubleAnimation.EasingFunction><StaticResource ResourceKey="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1" Duration="{StaticResource AnimFast}">
                                        <DoubleAnimation.EasingFunction><StaticResource ResourceKey="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1" Duration="{StaticResource AnimFast}">
                                        <DoubleAnimation.EasingFunction><StaticResource ResourceKey="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                     To="0" Duration="{StaticResource AnimFast}">
                                        <DoubleAnimation.EasingFunction><StaticResource ResourceKey="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Button.Style>
        <StackPanel>
            <!-- Thumbnail with watched-checkmark badge overlay. Grid allows the badge to float
                 over the top-right corner of the art without pushing layout. -->
            <Grid>
                <Border CornerRadius="{StaticResource CardImageRadius}"
                        Background="{StaticResource ThumbPlaceholderBrush}"
                        Height="{StaticResource CardThumbHeight}" ClipToBounds="True">
                    <Grid>
                        <!-- Neutral film glyph shown only when no cover image is available (not an avatar — videos aren't people). -->
                        <ui:SymbolIcon Symbol="MoviesAndTv24"
                                       FontSize="24" Opacity="0.35"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Cover, Converter={StaticResource NullToVisibility}}" />
                        <Image Source="{Binding Cover}"
                               Style="{StaticResource ThumbnailImage}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
            </Grid>
            <!-- Continue-watching progress track (color cue, kept) + text label (non-color cue, additive). -->
            <Border Height="4" CornerRadius="2" Margin="0,2,0,0" Background="{StaticResource ThumbPlaceholderBrush}">
                <Border HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource AccentBrush}"
                        Width="{Binding ProgressFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=200}" />
            </Border>
            <TextBlock Text="{Binding SeriesTitle}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding EpisodeLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
        </StackPanel>
    </Button>
</UserControl>
