<UserControl x:Class="VideoShelf.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters"
             Focusable="True"
             Background="Black">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/QueueStyles.xaml" />
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/PlayerStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
            <conv:NotNullOrEmptyToVisibility x:Key="NotNullOrEmptyVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Black"
          MouseMove="OnSurfaceMouseMove"
          MouseLeftButtonDown="OnVideoSurfaceMouseDown"
          MouseLeftButtonUp="OnVideoSurfaceMouseUp"
          MouseWheel="OnVideoSurfaceMouseWheel">
        <Border x:Name="PlayerShell" Background="Black">
            <vlc:VideoView x:Name="VideoSurface">
                <Grid x:Name="OverlayRoot">

                    <!-- Error / missing-file banner (additive) -->
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="20" CornerRadius="8" Background="{StaticResource PlayerPanelBrush}"
                            Visibility="{Binding Player.HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Player.PlaybackError}" Foreground="White"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                    </Border>

                    <!-- Resume-offer banner (additive) -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Padding="14,8" CornerRadius="6" Background="{StaticResource PlayerPanelBrush}"
                            Visibility="{Binding Player.CanResume, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Resume where you left off?" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Content="Resume" Command="{Binding Player.ResumeCommand}"
                                       Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>

                    <!-- E3: Skip feedback badge — centered, transient, always on top of controls layer -->
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="20,10" CornerRadius="8" Background="{StaticResource PlayerPanelBrush}"
                            Visibility="{Binding Player.SkipFeedback, Converter={StaticResource NotNullOrEmptyVis}}"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding Player.SkipFeedback}" Foreground="White"
                                   FontSize="28" FontWeight="SemiBold" />
                    </Border>

                    <!-- E4: Volume feedback badge — bottom-left, transient -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="12,0,0,100" Padding="14,6" CornerRadius="6"
                            Background="{StaticResource PlayerPanelBrush}"
                            Visibility="{Binding Player.VolumeFeedback, Converter={StaticResource NotNullOrEmptyVis}}"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding Player.VolumeFeedback}" Foreground="White" FontSize="14" />
                    </Border>

                    <!-- ===== Auto-hiding controls layer ===== -->
                    <Grid x:Name="ControlsLayer"
                          Visibility="{Binding Player.AreControlsVisible, Converter={StaticResource BoolToVisibility}}">

                        <!-- Top scrim + title/close (drag strip in PiP) -->
                        <Border x:Name="TopBar" VerticalAlignment="Top" Padding="12,8"
                                Background="{StaticResource PlayerTopScrimBrush}" MouseLeftButtonDown="OnTopBarMouseDown">
                            <Grid>
                                <TextBlock Text="{Binding Player.Title}" Foreground="White"
                                           VerticalAlignment="Center" FontSize="14"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,160,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button x:Name="BackToWindowButton"
                                               Command="{Binding TogglePictureInPictureCommand}"
                                               Visibility="Collapsed" Margin="0,0,8,0"
                                               Style="{StaticResource TertiaryButton}"
                                               ToolTip="Back to window">
                                        <ui:SymbolIcon Symbol="ArrowLeft24" />
                                    </ui:Button>
                                    <ui:Button Command="{Binding ClosePlayerCommand}"
                                               Style="{StaticResource TertiaryButton}"
                                               ToolTip="Close player">
                                        <ui:SymbolIcon Symbol="Dismiss24" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Seek-preview thumbnail popup (shown while scrubbing) -->
                        <Border x:Name="SeekPreview" Width="160" Height="90"
                                VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                Margin="0,0,0,96" CornerRadius="6" Background="{StaticResource PlayerPopupBrush}"
                                BorderBrush="{StaticResource PlayerPopupBorderBrush}" BorderThickness="1"
                                Visibility="{Binding Player.IsScrubbing, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding Player.SeekPreviewPath}" Stretch="UniformToFill" />
                        </Border>

                        <!-- ==========================================
                             Bottom transport — two-row layout
                             ========================================== -->
                        <Border VerticalAlignment="Bottom" Background="{StaticResource PlayerScrimBrush}" Padding="12,6,12,8">
                            <StackPanel>

                                <!-- ROW 1: Seek bar with time labels -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="White" VerticalAlignment="Center"
                                               Text="{Binding Player.PositionSeconds, StringFormat={}{0:0}s}"
                                               Margin="0,0,6,0" FontSize="12" />
                                    <Grid Grid.Column="1">
                                        <Slider x:Name="SeekBar" VerticalAlignment="Center"
                                                Minimum="0" Maximum="{Binding Player.LengthSeconds}"
                                                Value="{Binding Player.ScrubPosition, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Foreground="White" VerticalAlignment="Center"
                                               Text="{Binding Player.LengthSeconds, StringFormat={}{0:0}s}"
                                               Margin="6,0,0,0" FontSize="12" />
                                    <!-- E1: A-B active indicator chip -->
                                    <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Player.IsAbRepeatActive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="A-B" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- ROW 2: Controls — Left | Center | Right -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT ZONE: Volume -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPictureInPicture}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Volume button → expanding volume flyout Popup -->
                                        <ui:Button x:Name="VolumeButton"
                                                   Style="{StaticResource TransportIconButton}"
                                                   Click="OnVolumeButtonClick"
                                                   ToolTip="Volume">
                                            <ui:Button.Content>
                                                <ui:SymbolIcon x:Name="VolumeIcon" Symbol="Speaker224">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Speaker224" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Player.IsMuted}" Value="True">
                                                                    <Setter Property="Symbol" Value="SpeakerMute24" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </ui:Button.Content>
                                        </ui:Button>

                                        <!-- Volume flyout Popup (view concern — no VM flag) -->
                                        <Popup x:Name="VolumeFlyout"
                                               PlacementTarget="{Binding ElementName=VolumeButton}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Style="{StaticResource PlayerFlyoutBorder}" Width="160">
                                                <StackPanel>
                                                    <TextBlock Text="Volume" Foreground="White" FontSize="12"
                                                               Margin="0,0,0,6" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding Player.Volume}"
                                                            VerticalAlignment="Center" />
                                                    <ui:Button Margin="0,6,0,0"
                                                               Command="{Binding Player.ToggleMuteCommand}"
                                                               Style="{StaticResource TertiaryButton}"
                                                               HorizontalAlignment="Left"
                                                               ToolTip="Mute / Unmute">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="SpeakerMute24" Margin="0,0,6,0" />
                                                            <TextBlock Text="Mute" VerticalAlignment="Center"
                                                                       Foreground="White" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- CENTER ZONE: Skip-back / Play-pause / Skip-fwd -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <!-- Skip back 10s — PiP: show only on non-pip, match queue skip -->
                                        <ui:Button Command="{Binding Player.SkipBack10Command}"
                                                   Style="{StaticResource TransportIconButton}"
                                                   ToolTip="Skip back 10 s">
                                            <ui:SymbolIcon Symbol="SkipBack1024" />
                                        </ui:Button>

                                        <!-- Play / Pause -->
                                        <ui:Button Margin="4,0" Command="{Binding Player.TogglePlayPauseCommand}"
                                                   Style="{StaticResource TransportIconButton}"
                                                   ToolTip="Play / Pause">
                                            <ui:Button.Content>
                                                <ui:SymbolIcon x:Name="PlayPauseIcon" Symbol="Play24">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Play24" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                                                                    <Setter Property="Symbol" Value="Pause24" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </ui:Button.Content>
                                        </ui:Button>

                                        <!-- Skip forward 30s -->
                                        <ui:Button Command="{Binding Player.SkipForward30Command}"
                                                   Style="{StaticResource TransportIconButton}"
                                                   ToolTip="Skip forward 30 s">
                                            <ui:SymbolIcon Symbol="SkipForward3024" />
                                        </ui:Button>

                                        <!-- Queue: skip to next (visible when queue has items) — shown in PiP too -->
                                        <ui:Button Margin="4,0,0,0"
                                                   ToolTip="Skip to next"
                                                   Command="{Binding PlayQueue.SkipNextCommand}"
                                                   Visibility="{Binding PlayQueue.HasQueue, Converter={StaticResource BoolToVisibility}}"
                                                   Style="{StaticResource TransportIconButton}">
                                            <ui:SymbolIcon Symbol="Next24" />
                                        </ui:Button>

                                    </StackPanel>

                                    <!-- RIGHT ZONE: Tracks flyout / PiP / Fullscreen / More / Queue drawer -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPictureInPicture}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Tracks icon → tracks flyout (replaces inline ComboBoxes + "+Sub") -->
                                        <ui:Button x:Name="TracksButton"
                                                   Style="{StaticResource TransportIconButton}"
                                                   Click="OnTracksButtonClick"
                                                   ToolTip="Audio &amp; subtitles">
                                            <ui:SymbolIcon Symbol="ClosedCaption24" />
                                        </ui:Button>

                                        <!-- Tracks flyout Popup -->
                                        <Popup x:Name="TracksFlyout"
                                               PlacementTarget="{Binding ElementName=TracksButton}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Style="{StaticResource PlayerFlyoutBorder}" MinWidth="200" MaxWidth="280">
                                                <StackPanel>

                                                    <!-- Audio tracks -->
                                                    <TextBlock Text="AUDIO" Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold" Opacity="0.7"
                                                               Margin="0,0,0,4" />
                                                    <ListBox ItemsSource="{Binding Player.AudioTracks}"
                                                             SelectedItem="{Binding Player.SelectedAudioTrack}"
                                                             DisplayMemberPath="Label"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="White" />

                                                    <!-- D: Audio normalize toggle (hidden when engine doesn't support it) -->
                                                    <ToggleButton Margin="0,4,0,0"
                                                                  IsChecked="{Binding Player.VolumeNormalizeEnabled, Mode=TwoWay}"
                                                                  Style="{StaticResource ChipToggle}"
                                                                  HorizontalAlignment="Left"
                                                                  Visibility="{Binding Player.CanNormalizeVolume, Converter={StaticResource BoolToVisibility}}"
                                                                  ToolTip="Normalize audio volume">
                                                        <TextBlock Text="Normalize" Foreground="White" />
                                                    </ToggleButton>

                                                    <Separator Margin="0,6" Background="{StaticResource PlayerPopupBorderBrush}" />

                                                    <!-- Subtitle tracks -->
                                                    <TextBlock Text="SUBTITLES" Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold" Opacity="0.7"
                                                               Margin="0,0,0,4" />
                                                    <ListBox ItemsSource="{Binding Player.SubtitleTracks}"
                                                             SelectedItem="{Binding Player.SelectedSubtitleTrack}"
                                                             DisplayMemberPath="Label"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="White" />

                                                    <Separator Margin="0,6" Background="{StaticResource PlayerPopupBorderBrush}" />

                                                    <!-- Add subtitle file -->
                                                    <ui:Button Command="{Binding Player.AddSubtitleFileCommand}"
                                                               Style="{StaticResource TertiaryButton}"
                                                               HorizontalAlignment="Left"
                                                               ToolTip="Add subtitle file…">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ClosedCaption24" Margin="0,0,6,0" />
                                                            <TextBlock Text="+ Subtitle file" VerticalAlignment="Center"
                                                                       Foreground="White" />
                                                        </StackPanel>
                                                    </ui:Button>

                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <!-- PiP -->
                                        <ui:Button Margin="2,0,0,0" Command="{Binding TogglePictureInPictureCommand}"
                                                   Style="{StaticResource TransportIconButton}"
                                                   ToolTip="Mini-player">
                                            <ui:SymbolIcon Symbol="PictureInPicture24" />
                                        </ui:Button>

                                        <!-- Fullscreen -->
                                        <ui:Button Margin="2,0,0,0" Command="{Binding Player.ToggleFullscreenCommand}"
                                                   Style="{StaticResource TransportIconButton}"
                                                   ToolTip="Fullscreen">
                                            <ui:SymbolIcon Symbol="FullScreenMaximize24" />
                                        </ui:Button>

                                        <!-- More (⋯) overflow button -->
                                        <ui:Button x:Name="MoreButton"
                                                   Margin="2,0,0,0"
                                                   Style="{StaticResource TransportIconButton}"
                                                   Click="OnMoreButtonClick"
                                                   ToolTip="More options">
                                            <ui:SymbolIcon Symbol="MoreHorizontal24" />
                                        </ui:Button>

                                        <!-- More overflow flyout (extensible vertical list for D/E groups) -->
                                        <Popup x:Name="MoreFlyout"
                                               PlacementTarget="{Binding ElementName=MoreButton}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Style="{StaticResource PlayerFlyoutBorder}" MinWidth="180">
                                                <StackPanel>
                                                    <ui:Button Command="{Binding Player.ScreenshotCommand}"
                                                               Style="{StaticResource TertiaryButton}"
                                                               HorizontalAlignment="Stretch"
                                                               ToolTip="Screenshot">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Camera24" Margin="0,0,8,0" />
                                                            <TextBlock Text="Screenshot" VerticalAlignment="Center"
                                                                       Foreground="White" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                    <ui:Button Command="{Binding Player.SetCoverFromFrameCommand}"
                                                               Style="{StaticResource TertiaryButton}"
                                                               HorizontalAlignment="Stretch"
                                                               ToolTip="Set as cover">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Image24" Margin="0,0,8,0" />
                                                            <TextBlock Text="Set as cover" VerticalAlignment="Center"
                                                                       Foreground="White" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                    <Separator Margin="0,4" Background="{StaticResource PlayerPopupBorderBrush}" />

                                                    <!-- D: Speed row — active rate shown, six preset buttons -->
                                                    <Grid Margin="0,4,0,2">
                                                        <TextBlock Text="SPEED" Foreground="White" FontSize="11"
                                                                   FontWeight="SemiBold" Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Player.RateLabel}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                                    </Grid>
                                                    <WrapPanel Margin="0,0,0,4">
                                                        <ui:Button Content="0.5×" Command="{Binding Player.SetPlaybackRateCommand}" CommandParameter="0.5"
                                                                   Style="{StaticResource TertiaryButton}" Padding="6,3" MinHeight="0" Margin="0,0,2,2" />
                                                        <ui:Button Content="0.75×" Command="{Binding Player.SetPlaybackRateCommand}" CommandParameter="0.75"
                                                                   Style="{StaticResource TertiaryButton}" Padding="6,3" MinHeight="0" Margin="0,0,2,2" />
                                                        <ui:Button Content="1×" Command="{Binding Player.SetPlaybackRateCommand}" CommandParameter="1.0"
                                                                   Style="{StaticResource TertiaryButton}" Padding="6,3" MinHeight="0" Margin="0,0,2,2" />
                                                        <ui:Button Content="1.25×" Command="{Binding Player.SetPlaybackRateCommand}" CommandParameter="1.25"
                                                                   Style="{StaticResource TertiaryButton}" Padding="6,3" MinHeight="0" Margin="0,0,2,2" />
                                                        <ui:Button Content="1.5×" Command="{Binding Player.SetPlaybackRateCommand}" CommandParameter="1.5"
                                                                   Style="{StaticResource TertiaryButton}" Padding="6,3" MinHeight="0" Margin="0,0,2,2" />
                                                        <ui:Button Content="2×" Command="{Binding Player.SetPlaybackRateCommand}" CommandParameter="2.0"
                                                                   Style="{StaticResource TertiaryButton}" Padding="6,3" MinHeight="0" Margin="0,0,2,2" />
                                                    </WrapPanel>

                                                    <!-- D: Aspect/zoom row — cycle button -->
                                                    <ui:Button Command="{Binding Player.CycleAspectCommand}"
                                                               Style="{StaticResource TertiaryButton}"
                                                               HorizontalAlignment="Left"
                                                               ToolTip="Cycle aspect ratio">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Aspect: " VerticalAlignment="Center"
                                                                       Foreground="White" Margin="0,0,4,0" FontSize="12" />
                                                            <TextBlock Text="{Binding Player.SelectedAspect.Label}"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <Separator Margin="0,4" Background="{StaticResource PlayerPopupBorderBrush}" />

                                                    <!-- E1: A-B repeat row -->
                                                    <TextBlock Text="A-B REPEAT" Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold" Opacity="0.7"
                                                               Margin="0,4,0,4" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <ui:Button Command="{Binding Player.SetRepeatACommand}"
                                                                   Style="{StaticResource TertiaryButton}"
                                                                   Padding="6,3" MinHeight="0"
                                                                   ToolTip="Set A (start) point">
                                                            <TextBlock Foreground="White" FontSize="12"
                                                                       Text="{Binding Player.RepeatStartSeconds, StringFormat='A {0:0}s', TargetNullValue='Set A'}" />
                                                        </ui:Button>
                                                        <ui:Button Command="{Binding Player.SetRepeatBCommand}"
                                                                   Style="{StaticResource TertiaryButton}"
                                                                   Padding="6,3" MinHeight="0"
                                                                   Margin="4,0,0,0"
                                                                   ToolTip="Set B (end) point">
                                                            <TextBlock Foreground="White" FontSize="12"
                                                                       Text="{Binding Player.RepeatEndSeconds, StringFormat='B {0:0}s', TargetNullValue='Set B'}" />
                                                        </ui:Button>
                                                        <ui:Button Command="{Binding Player.ClearAbRepeatCommand}"
                                                                   Style="{StaticResource TertiaryButton}"
                                                                   Padding="6,3" MinHeight="0"
                                                                   Margin="4,0,0,0"
                                                                   ToolTip="Clear A-B repeat">
                                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                                        </ui:Button>
                                                    </StackPanel>

                                                    <!-- E5: Play from beginning (visible when completed) -->
                                                    <ui:Button Command="{Binding Player.PlayFromBeginningCommand}"
                                                               Style="{StaticResource TertiaryButton}"
                                                               HorizontalAlignment="Left"
                                                               Visibility="{Binding Player.IsCompleted, Converter={StaticResource BoolToVisibility}}"
                                                               ToolTip="Play from beginning">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ArrowReset24" Margin="0,0,8,0" />
                                                            <TextBlock Text="Play from beginning" VerticalAlignment="Center"
                                                                       Foreground="White" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <!-- Queue drawer toggle -->
                                        <ui:Button Margin="4,0,0,0"
                                                   Command="{Binding PlayQueue.ToggleDrawerCommand}"
                                                   Visibility="{Binding PlayQueue.HasQueue, Converter={StaticResource BoolToVisibility}}"
                                                   Style="{StaticResource TransportIconButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="List24" Margin="0,0,4,0" />
                                                <TextBlock Text="Up next" VerticalAlignment="Center" Foreground="White" />
                                            </StackPanel>
                                        </ui:Button>

                                    </StackPanel>

                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== F: Up-Next countdown card — bottom-right overlay ===== -->
                    <!-- Visible when IsUpNextVisible; opaque panel using PlayerPanelBrush.
                         Text countdown only (motion/ring polish deferred to M21). -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,100"
                            Width="260"
                            CornerRadius="8"
                            Background="{StaticResource PlayerPanelBrush}"
                            BorderBrush="{StaticResource PlayerPopupBorderBrush}"
                            BorderThickness="1"
                            IsHitTestVisible="True"
                            Visibility="{Binding UpNext.IsUpNextVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="12,10">

                            <!-- Header row: "Up next" label + countdown number -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="UP NEXT" Foreground="White" FontSize="11"
                                           FontWeight="SemiBold" Opacity="0.7"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" CornerRadius="12"
                                        Background="{StaticResource AccentBrush}"
                                        Padding="8,2">
                                    <TextBlock Text="{Binding UpNext.CountdownSeconds}"
                                               Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <!-- Thumbnail placeholder + title row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail slot: shows art when available, placeholder fill otherwise.
                                     Known limitation: UpNextThumbnailPath is always null (RecencyCard
                                     thumbnail path is never populated — video_art persists but not wired
                                     on cards). The placeholder fill (ThumbPlaceholderBrush) is always shown. -->
                                <Border Grid.Column="0" Height="45" CornerRadius="4"
                                        Background="{StaticResource ThumbPlaceholderBrush}"
                                        Margin="0,0,10,0">
                                    <Image Source="{Binding UpNext.UpNextThumbnailPath}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding UpNext.UpNextTitle}"
                                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextTrimming="None"
                                           MaxHeight="60"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Action buttons row -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Command="{Binding UpNext.DismissUpNextCommand}"
                                           Style="{StaticResource TertiaryButton}"
                                           Padding="10,4" MinHeight="28"
                                           ToolTip="Dismiss">
                                    <TextBlock Text="Dismiss" Foreground="White" FontSize="12" />
                                </ui:Button>
                                <ui:Button Command="{Binding UpNext.PlayNextNowCommand}"
                                           Style="{StaticResource PrimaryButton}"
                                           Padding="10,4" MinHeight="28"
                                           Margin="6,0,0,0"
                                           ToolTip="Play now">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" Margin="0,0,4,0" />
                                        <TextBlock Text="Play now" VerticalAlignment="Center"
                                                   FontSize="12" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ===== Queue drawer: right-side overlay, collapsed in PiP ===== -->
                    <Border x:Name="QueueDrawer"
                            HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Width="320" Background="{StaticResource PlayerDrawerBrush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PlayQueue.IsQueueOpen}" Value="True"/>
                                            <Condition Binding="{Binding IsPictureInPicture}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Margin="12">
                            <Grid DockPanel.Dock="Top">
                                <TextBlock Text="UP NEXT" Style="{StaticResource SectionHeader}"/>
                                <ui:Button HorizontalAlignment="Right"
                                           Command="{Binding PlayQueue.ClearCommand}"
                                           Style="{StaticResource TertiaryButton}"
                                           ToolTip="Clear queue">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" Margin="0,0,4,0" />
                                        <TextBlock Text="Clear" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                            <ItemsControl DataContext="{Binding PlayQueue}"
                                          ItemsSource="{Binding Items}"
                                          ItemTemplate="{StaticResource QueueItemTemplate}"
                                          Margin="0,8,0,0"/>
                        </DockPanel>
                    </Border>

                </Grid>
            </vlc:VideoView>
        </Border>

    </Grid>
</UserControl>
