<UserControl x:Class="VideoShelf.App.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:VideoShelf.App.Views"
             xmlns:controls="clr-namespace:VideoShelf.App.Views.Controls"
             xmlns:conv="clr-namespace:VideoShelf.App.Converters"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoShelf.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibility x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <TextBlock Grid.Row="0" Text="Favorites" Style="{StaticResource TypeRailHeader}"
                   Margin="24,16,24,0" FontSize="22"/>

        <!-- Selection header: Select toggle + Select all / Clear (selection mode only) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,8,24,4">
            <ToggleButton Content="Select"
                          IsChecked="{Binding Selection.IsSelectionMode, Mode=TwoWay}"
                          Style="{StaticResource ChipToggle}"
                          Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Select all"
                    Visibility="{Binding Selection.IsSelectionMode, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding Selection.SelectAllCommand}"
                    CommandParameter="{Binding Favorites}"
                    Margin="8,0,0,0" Padding="10,4"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" />
            <Button Content="Clear"
                    Visibility="{Binding Selection.IsSelectionMode, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding Selection.ClearSelectionCommand}"
                    Margin="4,0,0,0" Padding="10,4"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" />
        </StackPanel>

        <!-- Skeleton loading overlay: shown while IsLoading=true (async DB fetch in flight).
             Animate binds to MainViewModel.AnimationsEnabled via the ancestor Window's DataContext
             so the shimmer honours the OS reduced-motion setting without threading IMotionPolicy
             into every child VM. -->
        <controls:SkeletonPanel Grid.Row="2"
                                Margin="24,8,24,0"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                Animate="{Binding DataContext.AnimationsEnabled,
                                          RelativeSource={RelativeSource AncestorType=Window}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,24">

                <!-- Empty state -->
                <TextBlock Text="No favorites yet — mark videos with the heart icon to save them here."
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,40">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFavorites}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Favorites grid: virtualized, selectable -->
                <ListBox ItemsSource="{Binding Favorites}"
                         SelectionMode="Extended"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Style="{StaticResource PlainListBox}"
                         Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}"
                         KeyboardNavigation.TabNavigation="Once"
                         KeyboardNavigation.DirectionalNavigation="Contained">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel SpacingMode="Uniform" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <views:VideoCard
                                    IsHitTestVisible="{Binding DataContext.Selection.IsSelectionMode,
                                        RelativeSource={RelativeSource AncestorType=ListBox},
                                        Converter={StaticResource InverseBoolToBool}}" />
                                <CheckBox Width="{StaticResource CheckboxSize}"
                                          Height="{StaticResource CheckboxSize}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Margin="6,6,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding DataContext.Selection.IsSelectionMode,
                                              RelativeSource={RelativeSource AncestorType=ListBox},
                                              Converter={StaticResource BoolToVisibility}}"
                                          />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
