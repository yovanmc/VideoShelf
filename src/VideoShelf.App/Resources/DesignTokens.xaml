<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- ============================================================
         VideoShelf design system — owned (no longer borrowed from VideoTriage).
         Dark-only. Additive; never retemplate WPF-UI controls.

         Sections:
           COLORS
           BRUSHES (semantic)
           SURFACES / TEXT
           PLAYER SCRIM
           RADII & SPACING
           CARD SIZING
           TYPE RAMP
           BUTTONS
           CHIPS
           FOCUS
           IMAGE
         ============================================================ -->

    <!-- ============================================================
         COLORS — one named color per semantic meaning
         ============================================================ -->
    <Color x:Key="AccentColor">#4FC3F7</Color>
    <Color x:Key="SuccessColor">#36C98F</Color>
    <Color x:Key="WarningColor">#F5A524</Color>
    <Color x:Key="DangerColor">#F05252</Color>
    <Color x:Key="NeutralColor">#8B93A7</Color>

    <!-- ============================================================
         BRUSHES (semantic) — solid-color brushes keyed from colors above
         ============================================================ -->
    <SolidColorBrush x:Key="AccentBrush"  Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush"  Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}" />

    <!-- Faint semantic tints (~20% alpha) for banners / status fills -->
    <!-- SuccessTintBrush: #33 alpha over SuccessColor #36C98F -->
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#3336C98F" />
    <!-- WarningTintBrush: #33 alpha over WarningColor #F5A524 -->
    <SolidColorBrush x:Key="WarningTintBrush" Color="#33F5A524" />

    <!-- ============================================================
         SURFACES / TEXT — semantic brushes bridging to WPF-UI dark theme.
         DynamicResource keys confirmed present in WPF-UI 4.3.0 DLL.
         Fallback literals are used by views that load the dictionary
         outside a running Application (e.g., XAML designer, unit tests).
         ============================================================ -->

    <!-- App background — true-black canvas (#070707).
         M24-A: converted from <StaticResource> aliases (which forward to WPF-UI Mica keys)
         to DIRECT <SolidColorBrush> values so the color is independent of the window backdrop.
         Mica is disabled in MainWindow.xaml (WindowBackdropType="None") so these tokens
         are the sole source of surface colour.
         Views consume these as {StaticResource SurfaceBrush} / {StaticResource CardSurfaceBrush}
         (dark-only app, no runtime theme switching needed). -->
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#FF070707" />
    <!-- Card / panel fill — slightly lifted above true black to create depth. -->
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FF141414" />
    <!-- Primary / secondary text. Defined as DIRECT brushes (dark-only app) using the
         WPF-UI Fluent dark text values. NOTE: these were previously `<StaticResource>`
         aliases to the WPF-UI TextFillColor*Brush keys, but a nested <StaticResource>
         dictionary-value is resolved at DesignTokens-merge time, when the sibling
         ui:ThemesDictionary in the same MergedDictionaries is not yet visible — so the
         alias silently failed to materialise and the key did not exist at runtime
         (crash: "Cannot find resource named 'TextPrimaryBrush'"). Latent since M15
         because no view consumed these tokens until M17; caught by the M17 sweep.
         Direct brushes resolve reliably via {StaticResource} everywhere (cf. DividerBrush). -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
    <!-- Muted text: ~66% white. Replaces ad-hoc Opacity="0.6"/"0.7" on text labels.
         Passes WCAG AA on the dark canvas (~4.5:1 on #1C1C1C background). -->
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#A8FFFFFF" />

    <!-- Divider: deliberate visibility fix — was #22000000 (near-black, invisible on
         dark canvas); now #22FFFFFF (low-opacity white, visible on dark). -->
    <SolidColorBrush x:Key="DividerBrush" Color="#22FFFFFF" />

    <!-- Subtle overlay fill for interactive surfaces (chips, queue rows, etc.) -->
    <SolidColorBrush x:Key="SubtleFillBrush"       Color="#0F7F7F7F" />
    <!-- Chip/pill fill — readable on dark canvas and over hero art (SubtleFillBrush #0F.. was too faint to read as a pill). -->
    <SolidColorBrush x:Key="ChipFillBrush"         Color="#40FFFFFF" />
    <!-- Placeholder fill for thumbnail slots before image loads -->
    <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="#247F7F7F" />
    <!-- Caption text overlaid directly on card artwork -->
    <SolidColorBrush x:Key="CardCaptionBrush"       Color="#B0FFFFFF" />

    <!-- ============================================================
         PLAYER SCRIM — named versions of the player overlay literals
         ============================================================ -->
    <!-- Main video overlay / bottom gradient base -->
    <SolidColorBrush x:Key="PlayerScrimBrush"        Color="#B0101010" />
    <!-- Top gradient / title bar scrim (lighter) -->
    <SolidColorBrush x:Key="PlayerTopScrimBrush"     Color="#80101010" />
    <!-- Side / info panel background -->
    <SolidColorBrush x:Key="PlayerPanelBrush"        Color="#CC202020" />
    <!-- Popup / context-menu surface (nearly opaque) -->
    <SolidColorBrush x:Key="PlayerPopupBrush"        Color="#E0101010" />
    <!-- Popup border — low-opacity white outline -->
    <SolidColorBrush x:Key="PlayerPopupBorderBrush"  Color="#60FFFFFF" />
    <!-- Queue drawer background — slightly more opaque than popup -->
    <SolidColorBrush x:Key="PlayerDrawerBrush"        Color="#E6101010" />

    <!-- ============================================================
         RADII & SPACING
         ============================================================ -->
    <!-- Corner radii: large for cards, small for controls / chips -->
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <!-- Larger radius applied to card artwork images -->
    <CornerRadius x:Key="CardImageRadius">10</CornerRadius>

    <!-- Spacing scale (4 px base) for repeated layout roles -->
    <Thickness x:Key="SectionGap">0,24,0,8</Thickness>
    <Thickness x:Key="FieldLabelMargin">0,12,0,4</Thickness>
    <!-- Gap between card cells in WrapPanel / UniformGrid layouts -->
    <Thickness x:Key="CardGap">0,0,16,16</Thickness>

    <!-- ============================================================
         CARD SIZING — doubles consumed by ItemsControl ItemWidth / Height
         ============================================================ -->
    <sys:Double x:Key="CardWidth">200</sys:Double>
    <sys:Double x:Key="CardThumbHeight">112</sys:Double>

    <!-- ============================================================
         TYPE RAMP — keyed TextBlock styles
         ============================================================ -->
    <!-- Page / view title -->
    <Style x:Key="TypePageTitle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Rail / section header (large) -->
    <Style x:Key="TypeRailHeader" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Default body copy -->
    <Style x:Key="TypeBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Eyebrow label (small, accented, slightly transparent) -->
    <Style x:Key="TypeEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Opacity"    Value="0.85" />
    </Style>

    <!-- SectionHeader — alias for TypeEyebrow; kept for backward compat.
         All existing usages of SectionHeader continue to work unchanged. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock"
           BasedOn="{StaticResource TypeEyebrow}">
    </Style>

    <!-- StatValue — large number display (unchanged) -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Caption — small muted label. Uses TextMutedBrush directly (replaces Opacity="0.6"). -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="12" />
        <Setter Property="Foreground"  Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- ============================================================
         FOCUS — FocusVisualStyle adorner overlay.
         A FocusVisualStyle is an adorner, NOT a control template
         override — theming-rule-safe.
         Defined before BUTTONS so StaticResource references resolve cleanly.
         ============================================================ -->
    <Style x:Key="AppFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Rectangle Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="2"
                               Margin="2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         BUTTONS — additive styles; set only Appearance DP + sizing,
         never override ControlTemplate (theming-rule-safe)
         ============================================================ -->

    <!-- Primary action button -->
    <Style x:Key="PrimaryButton" TargetType="ui:Button"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance"       Value="Primary" />
        <Setter Property="Padding"          Value="14,6" />
        <Setter Property="MinHeight"        Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
    </Style>

    <!-- Secondary / ghost button -->
    <Style x:Key="SecondaryButton" TargetType="ui:Button"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance"       Value="Secondary" />
        <Setter Property="Padding"          Value="14,6" />
        <Setter Property="MinHeight"        Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
    </Style>

    <!-- Tertiary / text-like button -->
    <Style x:Key="TertiaryButton" TargetType="ui:Button"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance"       Value="Transparent" />
        <Setter Property="Padding"          Value="14,6" />
        <Setter Property="MinHeight"        Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
    </Style>

    <!-- ============================================================
         CHIPS — pill-shaped labels and toggles
         ============================================================ -->

    <!-- Read-only chip (Border wrapper) -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background"    Value="{StaticResource ChipFillBrush}" />
        <Setter Property="CornerRadius"  Value="12" />
        <Setter Property="Padding"       Value="10,4" />
    </Style>

    <!-- Toggle chip (plain WPF ToggleButton — NOT ui:ToggleButton, additive only).
         Uses triggers on IsChecked to flip background to accent; no ControlTemplate
         override — theming-rule-safe. -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="Background"       Value="{StaticResource ChipFillBrush}" />
        <Setter Property="Padding"          Value="10,4" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="BorderThickness"  Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FF000000" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.85" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         HIT TARGETS — minimum interactive size (WCAG 2.5.5, 44×44 px)
         Apply via BasedOn="{StaticResource HitTarget}" or directly on
         controls that lack a shared base style.
         ============================================================ -->
    <Style x:Key="HitTarget" TargetType="Control">
        <Setter Property="MinWidth"  Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <!-- ============================================================
         ANIMATION TOKENS (additive — M21)
         ============================================================ -->
    <Duration x:Key="AnimFast">0:0:0.12</Duration>
    <Duration x:Key="AnimNormal">0:0:0.22</Duration>
    <Duration x:Key="AnimSlow">0:0:0.35</Duration>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut"/>

    <!-- ============================================================
         IMAGE — shared thumbnail fade-in animation
         ============================================================ -->
    <!-- ThumbnailImage: Opacity defaults to 1 so a thumbnail is never stuck
         hidden if TargetUpdated doesn't fire; From=0 adds a fade on source arrival. -->
    <Style x:Key="ThumbnailImage" TargetType="Image">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
