<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ============================================================
         PlayerStyles — additive transport styles for PlayerView.
         Never retemplates a ui:* control. Depends on DesignTokens.
         ============================================================ -->

    <!-- Transport icon button: TertiaryButton base, compact padding,
         focus ring via AppFocusVisual. Set on all icon-only transport buttons. -->
    <Style x:Key="TransportIconButton" TargetType="ui:Button"
           BasedOn="{StaticResource TertiaryButton}">
        <Setter Property="Padding"          Value="8,6" />
        <Setter Property="MinHeight"        Value="36" />
        <Setter Property="MinWidth"         Value="36" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
    </Style>

    <!-- Volume flyout container: uses PlayerPopupBrush / PlayerPopupBorderBrush,
         rounded corners. Hosted inside a Popup IsOpen-toggled by the volume button. -->
    <Style x:Key="PlayerFlyoutBorder" TargetType="Border">
        <Setter Property="Background"    Value="{StaticResource PlayerPopupBrush}" />
        <Setter Property="BorderBrush"   Value="{StaticResource PlayerPopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"  Value="6" />
        <Setter Property="Padding"       Value="12,8" />
    </Style>

</ResourceDictionary>
