<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         Selection design tokens
         ============================================================ -->

    <!-- Low-alpha accent highlight for selected card overlay (~20% accent blue) -->
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#332C9CFF" />

    <!-- Checkbox size in the selection overlay -->
    <sys:Double x:Key="CheckboxSize">20</sys:Double>

    <!-- ============================================================
         PlainListBox — strips the ListBox chrome so it looks like
         the previous ItemsControl grid (transparent bg, no border).
         Plain WPF ListBox, NOT a ui:* control — additive template allowed.
         ============================================================ -->
    <Style x:Key="PlainListBox" TargetType="ListBox">
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="BorderThickness"  Value="0" />
        <Setter Property="Padding"          Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <!-- Scroll is handled by the outer ScrollViewer in MainWindow.xaml -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- ============================================================
         PlainListBoxItem — container for each card; transparent by default,
         shows a selection border when IsSelected AND selection mode is active.
         Plain WPF ListBoxItem — additive retemplate is allowed.
         ============================================================ -->
    <Style x:Key="PlainListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background"    Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"       Value="0" />
        <Setter Property="Margin"        Value="{StaticResource CardGap}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment"   Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- Retemplate is allowed: ListBoxItem is plain WPF, not a ui:* control. -->
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <!-- Card content (CreatorCard UserControl) -->
                        <ContentPresenter />
                        <!-- Selection overlay: accent border + low-alpha fill.
                             Visible only when this ListBoxItem is selected.
                             Note: IsSelectionMode gating happens via hit-test suppression
                             on the inner card button — this border always shows when selected,
                             but selection can only be toggled while IsSelectionMode is true. -->
                        <Border x:Name="SelectionOverlay"
                                CornerRadius="{StaticResource CardImageRadius}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                Background="{StaticResource SelectionHighlightBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
